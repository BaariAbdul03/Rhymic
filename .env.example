# Database (Supabase)
DATABASE_URL=postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# Supabase Storage
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIs...

# Email (Gmail SMTP)
SMTP_EMAIL=yourgmail@gmail.com
SMTP_PASSWORD=your-16-char-app-password

# AI
GOOGLE_API_KEY=your_key_here
GROQ_API_KEY=your_key_here
ENABLE_METADATA_FIXER=false

# Online streaming
# extractor = local/dev best-effort yt-dlp fallback
# resolver = call a separate resolver service
# disabled = hide/disable direct online audio resolution
ONLINE_STREAM_PROVIDER=extractor
RESOLVER_URL=http://localhost:3001
RESOLVER_API_KEY=change_me

# --- NEW: YouTube Streaming Anti-Bot Bypass Variables ---
# IMPORTANT: Use a BURNER Google account to generate these to avoid bans.

# 1. Base64-encoded contents of cookies.txt exported from a real browser.
#    Generate via: base64 -w 0 cookies.txt (Linux)
YT_COOKIES_B64=

# 2. Base64-encoded JSON OAuth credentials generated by the resolver microservice.
#    Run the resolver once, authenticate via TV Device Flow, and paste the output here.
YT_OAUTH_CREDENTIALS=

# 3. Comma-separated list of working Piped instances to override the dynamic fetch (optional)
YT_PIPED_INSTANCES=

# Auth
JWT_SECRET_KEY=generate_64_char_hex_with_python_secrets
