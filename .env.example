# Database (Supabase)
DATABASE_URL=postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# Supabase Storage
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIs...

# Email (Gmail SMTP)
SMTP_EMAIL=yourgmail@gmail.com
SMTP_PASSWORD=your-16-char-app-password

# AI
GOOGLE_API_KEY=your_key_here
GROQ_API_KEY=your_key_here
ENABLE_METADATA_FIXER=false

# ═══════════════════════════════════════════════════════════════════════════
#  Online Streaming (YouTube Audio)
# ═══════════════════════════════════════════════════════════════════════════

# Streaming mode (extractor | resolver | piped | auto | disabled)
#   extractor — tries all: resolver -> Piped -> yt-dlp (recommended)
#   piped     — Piped instances only (works on cloud without setup)
#   disabled  — hide online streaming entirely
ONLINE_STREAM_PROVIDER=extractor

# Resolver microservice (Node.js youtubei.js — runs separately)
RESOLVER_URL=http://localhost:3001
RESOLVER_API_KEY=change_me

# ── YouTube Anti-Bot Bypass Variables ──────────────────────────────────────
# IMPORTANT: Use a BURNER Google account to generate these to avoid bans.

# 1. Base64-encoded OAuth credentials (from TV_EMBEDDED device flow)
#    Run: bash scripts/setup_yt_oauth.sh  (or .\scripts\setup_yt_oauth.ps1)
#    Follow the URL, authenticate, paste the Base64 output here.
YT_OAUTH_CREDENTIALS=

# 2. Base64-encoded cookies.txt from a real browser (alternative to OAuth)
#    Generate via: base64 -w 0 cookies.txt (Linux/Mac)
#    Or use browser extension to export cookies in Netscape format
YT_COOKIES_B64=

# 3. Custom Piped instances (comma-separated, overrides curated list)
YT_PIPED_INSTANCES=

# 4. Proxy for yt-dlp (when using external residential proxy)
#    Format: socks5://127.0.0.1:40000 or http://proxy:8080
STREAM_PROXY=

# ── WARP Proxy (Cloudflare IP Bypass) ──────────────────────────────────────
# Enable WARP SOCKS5 proxy for bypassing YouTube datacenter IP blocks.
# Uses wireproxy (userspace WireGuard) — no root/TUN device needed.
WARP_ENABLED=false
WARP_MODE=wireproxy       # wireproxy | warp-cli | external
WARP_PORT=40000
WARP_EXTERNAL_PROXY=      # SOCKS5 URL for 'external' mode

# Stream cache TTL (seconds)
STREAM_CACHE_TTL_SECONDS=7200

# Auth
JWT_SECRET_KEY=generate_64_char_hex_with_python_secrets
